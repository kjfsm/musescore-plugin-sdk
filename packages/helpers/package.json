{
  "name": "@kjfsm/musescore-plugin-sdk-helpers",
  "version": "1.0.3",
  "description": "Lightweight runtime helpers for MuseScore 4 plugins written with @kjfsm/musescore-plugin-sdk-types.",
  "license": "MIT",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kjfsm/musescore-plugin-sdk",
    "directory": "packages/helpers"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "publint": "publint",
    "attw": "attw --pack --profile esm-only",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "peerDependencies": {
    "@kjfsm/musescore-plugin-sdk-types": "workspace:*"
  },
  "devDependencies": {
    "@kjfsm/musescore-plugin-sdk-types": "workspace:*",
    "typescript": "^5.7.0",
    "vitest": "^2.1.6"
  }
}
